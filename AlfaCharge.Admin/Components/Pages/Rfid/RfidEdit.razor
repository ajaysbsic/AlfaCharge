@page "/rfid/new"
@page "/rfid/{Id:guid}/edit"
@rendermode InteractiveServer
@inject RfidService RfidService
@inject UserService UserService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<RfidEdit> Logger

<PageTitle>@(_isNew ? "New RFID Card" : "Edit RFID Card") - AlfaCharge Admin</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="mb-4" />

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5" Class="mb-4">@(_isNew ? "Create New RFID Card" : "Edit RFID Card")</MudText>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.IdTag" 
                                  Label="ID Tag" 
                                  Required="true"
                                  RequiredError="ID Tag is required"
                                  Disabled="@(!_isNew)"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="Guid?" @bind-Value="_model.UserId" 
                               Label="Assign to User" 
                               Variant="Variant.Outlined"
                               Clearable="true">
                        @foreach (var user in _users)
                        {
                            <MudSelectItem Value="@((Guid?)Guid.Parse(user.Id))">@user.Name (@user.Email)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_model.Status" 
                               Label="Status" 
                               Required="true"
                               Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Active")">Active</MudSelectItem>
                        <MudSelectItem Value="@("Blocked")">Blocked</MudSelectItem>
                        <MudSelectItem Value="@("Expired")">Expired</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_expiryDate" 
                                   Label="Expiry Date" 
                                   Variant="Variant.Outlined"
                                   Clearable="true" />
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <div class="d-flex gap-2">
                <MudButton ButtonType="ButtonType.Submit" 
                           Variant="Variant.Filled" 
                           Color="Color.Primary"
                           Disabled="_saving">
                    @if (_saving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    @(_isNew ? "Create" : "Save")
                </MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="Cancel">Cancel</MudButton>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
            }
        </EditForm>
    }
</MudPaper>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private bool _isNew => Id is null;
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private RfidCardEditModel _model = new();
    private DateTime? _expiryDate;
    private List<UserViewModel> _users = [];
    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override async Task OnInitializedAsync()
    {
        _breadcrumbs =
        [
            new BreadcrumbItem("RFID Cards", "/rfid"),
            new BreadcrumbItem(_isNew ? "New" : "Edit", null, disabled: true)
        ];

        await LoadUsersAsync();

        if (!_isNew)
        {
            await LoadRfidCardAsync();
        }
        else
        {
            _loading = false;
        }
    }

    private async Task LoadUsersAsync()
    {
        var result = await UserService.GetUsersAsync(new PagingRequest { PageSize = 1000 });
        if (result.IsSuccess && result.Data is not null)
        {
            _users = result.Data.Items;
        }
    }

    private async Task LoadRfidCardAsync()
    {
        try
        {
            var result = await RfidService.GetRfidCardAsync(Id!.Value);
            if (result.IsSuccess && result.Data is not null)
            {
                var card = result.Data;
                _model = new RfidCardEditModel
                {
                    IdTag = card.IdTag,
                    UserId = !string.IsNullOrEmpty(card.UserId) ? Guid.Parse(card.UserId) : null,
                    Status = card.Status
                };
                _expiryDate = card.ExpiryDate?.DateTime;
                _breadcrumbs[1] = new BreadcrumbItem($"Edit: {card.IdTag}", null, disabled: true);
            }
            else
            {
                _error = "RFID card not found";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading RFID card {Id}", Id);
            _error = "Failed to load RFID card";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        _model.ExpiryDate = _expiryDate.HasValue ? new DateTimeOffset(_expiryDate.Value) : null;

        try
        {
            if (_isNew)
            {
                var result = await RfidService.CreateRfidCardAsync(_model);
                if (result.IsSuccess)
                {
                    Snackbar.Add("RFID card created successfully", Severity.Success);
                    Navigation.NavigateTo("/rfid");
                }
                else
                {
                    _error = result.Error ?? "Failed to create RFID card";
                }
            }
            else
            {
                var result = await RfidService.UpdateRfidCardAsync(Id!.Value, _model);
                if (result.IsSuccess)
                {
                    Snackbar.Add("RFID card updated successfully", Severity.Success);
                    Navigation.NavigateTo("/rfid");
                }
                else
                {
                    _error = result.Error ?? "Failed to update RFID card";
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving RFID card");
            _error = "An unexpected error occurred";
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/rfid");
    }
}
