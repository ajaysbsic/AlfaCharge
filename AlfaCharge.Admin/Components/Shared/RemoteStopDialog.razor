@using MudBlazor
@using AlfaCharge.Admin.Models

<MudDialog>
    <DialogContent>
        <MudNumericField @bind-Value="_request.TransactionId" 
                         Label="Transaction ID" 
                         Required="true"
                         Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Submit" 
                   Disabled="@(_request.TransactionId <= 0)">
            Stop
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance? MudDialog { get; set; }

    private RemoteStopRequest _request = new();

    private void Submit() => MudDialog?.Close(DialogResult.Ok(_request));
    private void Cancel() => MudDialog?.Cancel();
}
