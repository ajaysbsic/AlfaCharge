<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlfaGrid.Source.View.ReservationsPage"
             xmlns:viewModel="clr-namespace:AlfaGrid.Source.ViewModel"
             x:DataType="viewModel:ReservationsPageViewModel"
             Title="Reservations"
             Shell.NavBarIsVisible="True"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            
            <Label Text="Reservations"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#0E2A47"
                   Margin="0,16,0,8"/>

            <Label Text="No active reservations"
                   FontSize="16"
                   TextColor="#6D7A8A"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Margin="0,40,0,0"/>

            <Label Text="Your charging session reservations will appear here."
                   FontSize="14"
                   TextColor="#999999"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,8,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>