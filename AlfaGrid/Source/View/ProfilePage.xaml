<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModel="clr-namespace:AlfaGrid.Source.ViewModel"
             x:Class="AlfaGrid.Source.View.ProfilePage"
             x:DataType="viewModel:ProfilePageViewModel"
             xmlns:handlers="clr-namespace:AlfaGrid.Source.Handler"
             Title="Profile"
             Shell.NavBarIsVisible="True">
    
    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0">
            
            <!-- Header Section with Profile Picture -->
            <Grid BackgroundColor="#0066FF" 
                  Padding="16,40,16,60">
                <VerticalStackLayout Spacing="16" 
                                   HorizontalOptions="Center">
                    
                    <!-- Profile Picture -->
                    <Border WidthRequest="100" 
                            HeightRequest="100" 
                            BackgroundColor="#FFFFFF" 
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="50"/>
                        </Border.StrokeShape>
                        <Image Source="ic_user.png" 
                               Aspect="AspectFit" 
                               Margin="20"/>
                    </Border>
                    
                    <!-- User Name -->
                    <Label Text="{Binding FullName}" 
                           FontAttributes="Bold" 
                           FontSize="24" 
                           TextColor="White"
                           HorizontalOptions="Center"/>
                    
                    <!-- User Email -->
                    <Label Text="{Binding Email}" 
                           FontSize="14" 
                           TextColor="White"
                           Opacity="0.9"
                           HorizontalOptions="Center"/>
                    
                    <!-- User Role -->
                    <Border BackgroundColor="#FFFFFF30"
                            Padding="12,6"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding RoleText}" 
                               FontSize="12" 
                               TextColor="White"
                               FontAttributes="Bold"/>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!-- Edit Profile Section -->
            <VerticalStackLayout Spacing="20" 
                               Padding="16"
                               Margin="0,-30,0,0">
                
                <!-- Edit Profile Card -->
                <Border BackgroundColor="White"
                        StrokeShape="RoundRectangle 16"
                        Stroke="#E0E0E0"
                        StrokeThickness="1"
                        Padding="20">
                    <VerticalStackLayout Spacing="20">
                        
                        <Label Text="Personal Information" 
                               FontSize="18" 
                               FontAttributes="Bold"
                               TextColor="#0E2A47"/>
                        
                        <!-- Full Name Field -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Full Name" 
                                   FontSize="12" 
                                   TextColor="#6D7A8A"
                                   FontAttributes="Bold"/>
                            <Border BackgroundColor="White"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#E0E0E0"
                                    StrokeThickness="1"
                                    Padding="4">
                                <handlers:BorderlessEntry
                                    Text="{Binding FullName}" 
                                    FontSize="16"
                                    TextColor="#0E2A47"
                                    IsEnabled="{Binding IsEditing}"
                                    Placeholder="Enter full name"/>
                            </Border>
                        </VerticalStackLayout>
                        
                        <!-- Email Field -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Email Address" 
                                   FontSize="12" 
                                   TextColor="#6D7A8A"
                                   FontAttributes="Bold"/>
                            <Border BackgroundColor="White"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#E0E0E0"
                                    StrokeThickness="1"
                                    Padding="4">
                                <handlers:BorderlessEntry
                                    Text="{Binding Email}"
                                    FontSize="16"
                                    TextColor="#0E2A47"
                                    Keyboard="Email"
                                    IsEnabled="{Binding IsEditing}"
                                    Placeholder="Enter email address"/>
                            </Border>
                        </VerticalStackLayout>
                        
                        <!-- Role Field (Read-only) -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Role" 
                                   FontSize="12" 
                                   TextColor="#6D7A8A"
                                   FontAttributes="Bold"/>
                            <Border BackgroundColor="#F5F5F5"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#E0E0E0"
                                    StrokeThickness="1"
                                    Padding="8">
                                <Label Text="{Binding RoleText}" 
                                       FontSize="16"
                                       TextColor="#6D7A8A"/>
                            </Border>
                        </VerticalStackLayout>
                        
                        <!-- Edit/Save Button -->
                        <Border BackgroundColor="#0066FF"
                                StrokeThickness="0"
                                HeightRequest="50"
                                Margin="0,10,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="25"/>
                            </Border.StrokeShape>
                            <Label Text="{Binding EditButtonText}"
                                   TextColor="White"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleEditCommand}"/>
                            </Border.GestureRecognizers>
                        </Border>
                        
                        <!-- Cancel Button (only visible when editing) -->
                        <Border BackgroundColor="White"
                                Stroke="#E0E0E0"
                                StrokeThickness="1"
                                HeightRequest="50"
                                IsVisible="{Binding IsEditing}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="25"/>
                            </Border.StrokeShape>
                            <Label Text="Cancel"
                                   TextColor="#0066FF"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CancelEditCommand}"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Additional Options -->
                <Border BackgroundColor="White"
                        StrokeShape="RoundRectangle 16"
                        Stroke="#E0E0E0"
                        StrokeThickness="1"
                        Padding="0">
                    <VerticalStackLayout Spacing="0">
                        
                        <!-- Change Password -->
                        <Grid Padding="20,16" 
                              ColumnDefinitions="Auto,*,Auto">
                            <Image Grid.Column="0"
                                   Source="lock_icon.png"
                                   HeightRequest="24"
                                   WidthRequest="24"
                                   VerticalOptions="Center"
                                   Margin="0,0,12,0"/>
                            <Label Grid.Column="1"
                                   Text="Change Password"
                                   FontSize="16"
                                   TextColor="#0E2A47"
                                   VerticalOptions="Center"/>
                            <Image Grid.Column="2"
                                   Source="arrow_right.png"
                                   HeightRequest="20"
                                   WidthRequest="20"
                                   VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangePasswordCommand}"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                        
                        <BoxView HeightRequest="1" 
                                 BackgroundColor="#E0E0E0" 
                                 Margin="20,0"/>
                        
                        <!-- Notification Settings -->
                        <Grid Padding="20,16" 
                              ColumnDefinitions="Auto,*,Auto">
                            <Image Grid.Column="0"
                                   Source="notification_icon.png"
                                   HeightRequest="24"
                                   WidthRequest="24"
                                   VerticalOptions="Center"
                                   Margin="0,0,12,0"/>
                            <Label Grid.Column="1"
                                   Text="Notification Settings"
                                   FontSize="16"
                                   TextColor="#0E2A47"
                                   VerticalOptions="Center"/>
                            <Image Grid.Column="2"
                                   Source="arrow_right.png"
                                   HeightRequest="20"
                                   WidthRequest="20"
                                   VerticalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NotificationSettingsCommand}"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>