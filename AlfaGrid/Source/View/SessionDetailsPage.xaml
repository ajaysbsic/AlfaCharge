<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlfaGrid.Source.View.SessionDetailsPage"
             xmlns:viewModel="clr-namespace:AlfaGrid.Source.ViewModel"
             xmlns:controls="clr-namespace:AlfaGrid.Source.Controls"
             xmlns:local="clr-namespace:AlfaGrid.Source.Converters"
             x:DataType="viewModel:SessionDetailsPageViewModel"
             Title="{local:Translate SessionDetails_Title}"
             Shell.NavBarIsVisible="True">

    <Shell.TitleView>
        <Grid Padding="10,0">
            <ImageButton Source="arrow_left.png"
                        HeightRequest="24"
                        WidthRequest="24"
                        Command="{Binding GoBackCommand}"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"/>
            
            <Label Text="{local:Translate SessionDetails_Title}"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"/>
        </Grid>
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <!-- Station Header -->
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding StationName}"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#0E2A47"/>
                <Label Text="{Binding LocationName}"
                       FontSize="14"
                       TextColor="#6D7A8A"/>
                <Label TextColor="#999999"
                       FontSize="13">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding SessionDate, StringFormat='{0:dd-MM-yyyy}'}"/>
                            <Span Text=" | "/>
                            <Span Text="{Binding SessionTime, StringFormat='{0:hh:mm tt}'}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Text="{Binding EvseId}"
                       FontSize="13"
                       TextColor="#999999"/>
            </VerticalStackLayout>

            <!-- Total Cost Banner -->
            <Border BackgroundColor="#0066FF"
                    StrokeThickness="0"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Grid.Column="0"
                           Text="{local:Translate SessionDetails_TotalCost}"
                           TextColor="White"
                           FontSize="16"
                           VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           TextColor="White"
                           FontSize="32"
                           FontAttributes="Bold"
                           VerticalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="SAR"/>
                                <Span Text="{Binding TotalCost, StringFormat='{0:F2}'}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Grid>
            </Border>

            <!-- Cost Breakdown -->
            <VerticalStackLayout Spacing="1">
                <!-- Current Charging Cost -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="{local:Translate SessionDetails_CurrentChargingCost}"
                               TextColor="#6D7A8A"
                               FontSize="14"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               TextColor="#0E2A47"
                               FontSize="16"
                               VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="SAR"/>
                                    <Span Text="{Binding CurrentChargingCost, StringFormat='{0:F2}'}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>
                </Border>

                <!-- Energy Charges -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="{local:Translate SessionDetails_EnergyCharges}"
                               TextColor="#6D7A8A"
                               FontSize="14"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               TextColor="#0E2A47"
                               FontSize="16"
                               VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="SAR"/>
                                    <Span Text="{Binding EnergyCharges, StringFormat='{0:F2}'}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>
                </Border>

                <!-- Time Charges -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="{local:Translate SessionDetails_TimeCharges}"
                               TextColor="#6D7A8A"
                               FontSize="14"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               TextColor="#0E2A47"
                               FontSize="16"
                               VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="SAR"/>
                                    <Span Text="{Binding TimeCharges, StringFormat='{0:F2}'}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>
                </Border>

                <!-- Parking Charges -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="{local:Translate SessionDetails_ParkingCharges}"
                               TextColor="#6D7A8A"
                               FontSize="14"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               TextColor="#0E2A47"
                               FontSize="16"
                               VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="SAR"/>
                                    <Span Text="{Binding ParkingCharges, StringFormat='{0:F2}'}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>
                </Border>

                <!-- Fixed Charges -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="{local:Translate SessionDetails_FixedCharges}"
                               TextColor="#6D7A8A"
                               FontSize="14"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               TextColor="#0E2A47"
                               FontSize="16"
                               VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="SAR"/>
                                    <Span Text="{Binding FixedCharges, StringFormat='{0:F2}'}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Session Info -->
            <VerticalStackLayout Spacing="1">
                <!-- Charging Duration -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="{local:Translate SessionDetails_ChargingDuration}"
                               TextColor="#6D7A8A"
                               FontSize="14"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="{Binding ChargingDuration}"
                               TextColor="#0E2A47"
                               FontSize="16"
                               VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Idle Duration -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="{local:Translate SessionDetails_IdleDuration}"
                               TextColor="#6D7A8A"
                               FontSize="14"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="{Binding IdleDuration}"
                               TextColor="#0E2A47"
                               FontSize="16"
                               VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Est. End Battery SoC -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="{local:Translate SessionDetails_EstEndBatterySoC}"
                               TextColor="#6D7A8A"
                               FontSize="14"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="{Binding EstEndBatterySoC}"
                               TextColor="#0E2A47"
                               FontSize="16"
                               VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Energy Added -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="{local:Translate SessionDetails_EnergyAdded}"
                               TextColor="#6D7A8A"
                               FontSize="14"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               TextColor="#0E2A47"
                               FontSize="16"
                               VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding EnergyAdded, StringFormat='{0:F2}'}"/>
                                    <Span Text=" kWh"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Status Message -->
            <Label Text="{local:Translate SessionDetails_RemoteStopped}"
                   FontSize="14"
                   TextColor="#6D7A8A"
                   HorizontalTextAlignment="Center"
                   Margin="0,8,0,0"/>

            <!-- Continue Button -->
            <Button Text="{local:Translate SessionDetails_Continue}"
                    BackgroundColor="#F79A1B"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="56"
                    CornerRadius="28"
                    Command="{Binding ContinueCommand}"
                    Margin="0,12,0,20">
                <Button.Shadow>
                    <Shadow Brush="Black" Opacity="0.2" Offset="0,4" Radius="8"/>
                </Button.Shadow>
            </Button>

        </VerticalStackLayout>
    </ScrollView>

    <!-- Loading Overlay -->
    <controls:LoadingOverlay IsVisible="{Binding IsBusy}"
                            LoadingText="{local:Translate Loading}"/>
</ContentPage>
