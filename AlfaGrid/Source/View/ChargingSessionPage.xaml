<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlfaGrid.Source.View.ChargingSessionPage"
             xmlns:viewModel="clr-namespace:AlfaGrid.Source.ViewModel"
             xmlns:controls="clr-namespace:AlfaGrid.Source.Controls"
             xmlns:local="clr-namespace:AlfaGrid.Source.Converters"
             x:DataType="viewModel:ChargingSessionPageViewModel"
             Title="{local:Translate ChargingSession_Title}"
             Shell.NavBarIsVisible="True"
             Shell.BackButtonBehavior="{Binding BackButtonBehavior}">

    <Shell.TitleView>
        <Grid Padding="10,0" ColumnDefinitions="Auto,*,Auto">
            <ImageButton Grid.Column="0"
                        Source="arrow_left.png"
                        HeightRequest="24"
                        WidthRequest="24"
                        Command="{Binding GoBackCommand}"
                        VerticalOptions="Center"/>

            <Label Grid.Column="1"
                   Text="{local:Translate ChargingSession_Title}"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"/>

            <ImageButton Grid.Column="2"
                        Source="support_icon.png"
                        HeightRequest="24"
                        WidthRequest="24"
                        Command="{Binding ContactSupportCommand}"
                        VerticalOptions="Center"/>
        </Grid>
    </Shell.TitleView>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- Status Card -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.1" Offset="0,2" Radius="8"/>
                    </Border.Shadow>

                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                        <!-- Status Badges -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <!-- Online Badge -->
                            <Border BackgroundColor="#4CAF50"
                                    Padding="12,6"
                                    HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20"/>
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="📡"
                                           FontSize="14"
                                           VerticalOptions="Center"/>
                                    <Label Text="{local:Translate ChargingSession_Online}"
                                           TextColor="White"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Charging Status Badge -->
                            <Border Grid.Column="2"
                                    BackgroundColor="#F5F7FB"
                                    Padding="12,6"
                                    HorizontalOptions="End">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20"/>
                                </Border.StrokeShape>
                                <Label Text="{Binding ChargingStatus}"
                                       TextColor="#0E2A47"
                                       FontSize="14"
                                       FontAttributes="Bold"/>
                            </Border>
                        </Grid>

                        <!-- Station Info -->
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,8,0,0">
                            <Border BackgroundColor="#F0F4FA"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    VerticalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Label Text="⚡"
                                       FontSize="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding StationName}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#0E2A47"/>
                                <Label TextColor="#6D7A8A" FontSize="14">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{local:Translate ChargingSession_Station}"/>
                                            <Span Text=" : "/>
                                            <Span Text="{Binding LocationName}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Time & Duration Cards -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <!-- Start Time -->
                    <Border Grid.Column="0"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.1" Offset="0,2" Radius="8"/>
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="{local:Translate ChargingSession_StartTime}"
                                   TextColor="#6D7A8A"
                                   FontSize="14"/>
                            <Label Text="{Binding StartTime, StringFormat='{0:hh:mm tt}'}"
                                   TextColor="#0066FF"
                                   FontSize="24"
                                   FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Duration -->
                    <Border Grid.Column="1"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.1" Offset="0,2" Radius="8"/>
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="{local:Translate ChargingSession_Duration}"
                                   TextColor="#6D7A8A"
                                   FontSize="14"/>
                            <Label Text="{Binding Duration}"
                                   TextColor="#0066FF"
                                   FontSize="24"
                                   FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Energy & Connector Cards -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <!-- Energy Consumed -->
                    <Border Grid.Column="0"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.1" Offset="0,2" Radius="8"/>
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="{local:Translate ChargingSession_EnergyConsumed}"
                                   TextColor="#6D7A8A"
                                   FontSize="14"/>
                            <Label TextColor="#0066FF"
                                   FontSize="24"
                                   FontAttributes="Bold">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding EnergyConsumed, StringFormat='{0:F2}'}"/>
                                        <Span Text=" kWh" FontSize="16"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Connector Type -->
                    <Border Grid.Column="1"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.1" Offset="0,2" Radius="8"/>
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="{local:Translate ChargingSession_ConnectorType}"
                                   TextColor="#6D7A8A"
                                   FontSize="14"/>
                            <!-- Use emoji as fallback for missing image -->
                            <Label Text="🔌"
                                   FontSize="48"
                                   HorizontalOptions="Start"/>
                            <!--
                            <Image Source="{Binding ConnectorTypeImage}"
                                   HeightRequest="48"
                                   WidthRequest="48"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Start"/>
                            -->
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Session Cost -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.1" Offset="0,2" Radius="8"/>
                    </Border.Shadow>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="{local:Translate ChargingSession_SessionCost}"
                               TextColor="#6D7A8A"
                               FontSize="14"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               TextColor="#0066FF"
                               FontSize="28"
                               FontAttributes="Bold"
                               VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="SAR "/>
                                    <Span Text="{Binding SessionCost, StringFormat='{0:F2}'}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>
                </Border>

                <!-- Last Updated -->
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,8,0,0">
                    <Border BackgroundColor="#FF9800"
                            WidthRequest="32"
                            HeightRequest="32"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Label Text="🔄"
                               FontSize="16"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                    <Label TextColor="#6D7A8A"
                           FontSize="13"
                           VerticalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{local:Translate ChargingSession_LastUpdated}"/>
                                <Span Text=" "/>
                                <Span Text="{Binding LastUpdated, StringFormat='{0:dd-MM-yyyy | hh:mm tt}'}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </HorizontalStackLayout>

                <!-- Warning Message -->
                <Label Text="{local:Translate ChargingSession_Warning}"
                       TextColor="#F44336"
                       FontSize="14"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       Margin="0,20,0,0"/>

                <!-- Stop Charging Button -->
                <Button Text="{local:Translate ChargingSession_StopCharging}"
                        BackgroundColor="#F44336"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        HeightRequest="56"
                        CornerRadius="28"
                        Command="{Binding StopChargingCommand}"
                        Margin="0,8,0,20">
                    <Button.Shadow>
                        <Shadow Brush="Black" Opacity="0.2" Offset="0,4" Radius="8"/>
                    </Button.Shadow>
                </Button>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <controls:LoadingOverlay IsVisible="{Binding IsBusy}"
                                LoadingText="{local:Translate Loading}"/>
        
        <!-- Ending Session Overlay -->
        <controls:EndingSessionOverlay IsVisible="{Binding IsEndingSession}"
                                      Message="{local:Translate EndingSession_Message}"/>
    </Grid>
</ContentPage>